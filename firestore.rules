rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny for unhandled paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Authentication helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Rules for 'events' collection (Node Physical Events)
    match /events/{eventId} {
      allow read: if isSignedIn() && (
        resource.data.uid == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        resource.data.pairedUid == request.auth.uid
      );
      allow create: if isSignedIn() 
        && request.resource.data.deviceId != null 
        && request.resource.data.type in ['SMS_RECEIVED', 'CALL_MISSED', 'NOTIFICATION_RECEIVED', 'USSD_RESPONSE']
        && request.resource.data.timestamp is number;
      allow update: if isSignedIn() && (
        resource.data.deviceId == request.resource.data.deviceId &&
        (resource.data.uid == request.auth.uid || resource.data.userId == request.auth.uid || resource.data.pairedUid == request.auth.uid)
      );
      allow delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.uid == request.auth.uid ||
        resource.data.pairedUid == request.auth.uid
      );
    }

    // Rules for 'devices' collection
    match /devices/{deviceId} {
      allow read: if isSignedIn() && (
        resource.data.pairedUid == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        resource.data.deviceId == deviceId
      );
      allow create: if isSignedIn() && request.resource.data.deviceId == deviceId;
      allow update: if isSignedIn() && (
        request.resource.data.deviceId == deviceId &&
        (resource.data.pairedUid == request.auth.uid || resource.data.userId == request.auth.uid || request.resource.data.pairedUid == request.auth.uid)
      );
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.pairedUid == request.auth.uid);
    }

    // Rules for 'outbound_commands' collection (PWA -> Agent command queue)
    match /outbound_commands/{commandId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.nodeId != null
        && request.resource.data.type in ['SEND_SMS', 'MAKE_CALL', 'RUN_USSD']
        && request.resource.data.status in ['QUEUED', 'EXECUTING', 'RESULT_CONFIRMED', 'FAILED', 'EXPIRED'];
      allow update: if isSignedIn() && (
        // Agent atualizando status de execução ou PWA cancelando
        request.resource.data.status in ['QUEUED', 'EXECUTING', 'RESULT_CONFIRMED', 'FAILED', 'EXPIRED']
      );
      allow delete: if isSignedIn();
    }

    // Rules for 'presence' collection (Strict heartbeat / presence pulse)
    match /presence/{presenceId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (
        request.resource.data.lastHeartbeat is number &&
        request.resource.data.ttlMs is number
      );
      allow delete: if isSignedIn();
    }


    // Rules for 'users' collection and user subcollections
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /{allPaths=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Rules for 'settings' collection
    match /settings/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Rules for 'sessions' collection
    match /sessions/{sessionId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Rules for WebPush VAPID key configuration
    match /vapid_keys/{keyId} {
      allow read, write: if isSignedIn();
    }

    match /config/push_auth {
      allow read, write: if isSignedIn();
    }

    // Rules for 'update_logs' collection (PWA Version Lifecycle Telemetry in the field)
    match /update_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if true;
      allow update, delete: if isSignedIn();
    }

    // Rules for 'system_logs' collection (Unified Centralized Audit & Telemetry)
    match /system_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if true;
      allow update, delete: if isSignedIn();
    }

    // Camada 22 — Firestore 5.0 Rules
    match /presence/{presenceId} {
      allow read, write: if isSignedIn();
    }

    match /telemetry/{telemetryId} {
      allow read, write: if isSignedIn();
    }

    match /call_sessions/{sessionId} {
      allow read, write: if isSignedIn();
    }

    match /voicemail/{voicemailId} {
      allow read, write: if isSignedIn();
    }

    match /pairing_tokens/{tokenId} {
      allow read, write: if isSignedIn();
    }

    match /trusted_devices/{deviceId} {
      allow read, write: if isSignedIn();
    }

    match /blocked_devices/{deviceId} {
      allow read, write: if isSignedIn();
    }

    match /app_registry/{appId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /user_preferences/{uid} {
      allow read, write: if isOwner(uid);
    }

    match /wallpapers/{wallpaperId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /themes/{themeId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
  }
}

