rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny for unhandled paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Authentication helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Rules for 'events' collection
    match /events/{eventId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.uid == request.auth.uid);
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || request.resource.data.uid == request.auth.uid);
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.uid == request.auth.uid);
    }

    // Rules for 'devices' collection
    match /devices/{deviceId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.uid == request.auth.uid);
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || request.resource.data.uid == request.auth.uid);
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.uid == request.auth.uid);
    }

    // Rules for 'users' collection and user subcollections
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /{allPaths=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Rules for 'settings' collection
    match /settings/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Rules for 'sessions' collection
    match /sessions/{sessionId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Rules for WebPush VAPID key configuration
    match /vapid_keys/{keyId} {
      allow read, write: if isSignedIn();
    }

    match /config/push_auth {
      allow read, write: if isSignedIn();
    }
  }
}
