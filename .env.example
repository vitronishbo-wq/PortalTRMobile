# --- CONFIGURAÇÃO DO SERVIDOR ---
NODE_ENV=production
PORT=10000
APP_NAME=PortalTRMobile
APP_URL=https://portaltrmobile-api.onrender.com
FRONTEND_URL=https://portaltrmobile.web.app
RENDER_EXTERNAL_URL=https://portaltrmobile-api.onrender.com
COUNTRY=AO
DEFAULT_LANGUAGE=pt-AO
TIMEZONE=Africa/Luanda

# --- CREDENCIAIS DE SUPERADMIN / BOOTSTRAP (RECUPERAÇÃO DE ACESSO) ---
ADMIN_BOOTSTRAP_SECRET=YOUR_ADMIN_BOOTSTRAP_SECRET
SUPERUSER_EMAIL=deusfundador@vitronis.co.ao

# --- SEGURANÇA INTERNA DO VITRONIS COMMUNICATION OS ---
COS_MASTER_SECRET=YOUR_COS_MASTER_SECRET

# --- FIREBASE WEB CONFIG (CLIENTE FRONTEND/PWA) ---
FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
FIREBASE_AUTH_DOMAIN=portaltrmobile.firebaseapp.com
FIREBASE_PROJECT_ID=portaltrmobile
FIREBASE_STORAGE_BUCKET=portaltrmobile.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=703051403619
FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID
FIREBASE_MEASUREMENT_ID=G-WL35V04XQG

# --- FIREBASE PUBLIC CLIENT CONFIGURATION (Vite Frontend / GitHub Secrets) ---
VITE_API_URL=https://portaltrmobile-api.onrender.com
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID
VITE_FIREBASE_AUTH_DOMAIN=portaltrmobile.firebaseapp.com
VITE_FIREBASE_MESSAGING_SENDER_ID=703051403619
VITE_FIREBASE_PROJECT_ID=portaltrmobile
VITE_FIREBASE_STORAGE_BUCKET=portaltrmobile.firebasestorage.app

# --- FIREBASE ADMIN SDK (BACKEND & FIRESTORE SECURITY) ---
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@portaltrmobile.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY_ID=YOUR_FIREBASE_PRIVATE_KEY_ID
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# --- INTELIGÊNCIA ARTIFICIAL ---
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# --- GATEWAY DE TELEFONIA / TWILIO (CPAAS) ---
TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
TWILIO_PHONE_NUMBER=YOUR_TWILIO_PHONE_NUMBER

# --- PAGAMENTOS PROXYPAY ANGOLA (SANDBOX TESTES) ---
PROXYPAY_API_KEY=YOUR_PROXYPAY_API_KEY
PROXYPAY_ENTITY=99999
PROXYPAY_WEBHOOK_SECRET=YOUR_PROXYPAY_WEBHOOK_SECRET

# --- ECOSSISTEMA VITRONIS IdP ---
VITRONIS_ENV=production
VITRONIS_PLATFORM=vitronis
VITRONIS_DOMAIN=vitronis.co.ao
VITRONIS_WEB=https://vitronis.co.ao
VITRONIS_API=https://vitronis.co.ao
VITRONIS_CONSOLE=https://vitronis.co.ao
VITRONIS_STATUS=https://vitronis.co.ao
VITRONIS_DEFAULT_LANGUAGE=pt-AO